*.db-wal
*.db-shm
*.bak
*.bak-*
backups/

# ── Logs e saídas de pipeline ───────────────────────────────────────
*.log
.background_output_*.txt
exports/

# ── Artefatos de build / deploy ─────────────────────────────────────
medquest_deploy.zip
dist/
build/

# ── Instaladores e material-fonte (grandes binários) ────────────────
*.exe
*.pdf

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-*/
.codex-pytest-*/
.coverage
htmlcov/

# ── Node / Next.js ──────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.vercel

# ── IDE ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
.claude/settings.local.json

