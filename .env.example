# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Gemini — pool com uma ou mais chaves para explicações, preceptor e flashcards
# Gere em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: várias chaves separadas por vírgula (tem precedência sobre GEMINI_API_KEY).
GEMINI_API_KEYS=
# Opcional: ordem de fallback de modelos separada por vírgula.
# Ex.: gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash
GEMINI_MODELS=
# Opcional: espera mínima, em segundos, após uma quota diária/financeira por chave.
# Chaves de contas distintas continuam sendo usadas normalmente.
GEMINI_ACCOUNT_QUOTA_COOLDOWN=86400

# Provedor de IA ativo (Gemini exclusivo)
AI_PROVIDER_ORDER=gemini
AI_PRECEPTOR_PROVIDER_ORDER=gemini
AI_DAILY_QUOTA_COOLDOWN=86400
# Orçamento total e timeout por requisição, em segundos.
AI_GLOBAL_TIMEOUT_BUDGET=30
AI_PROVIDER_TIMEOUT=10

# Flask
FLASK_ENV=development
FLASK_PORT=5050
# Lista de origens CORS explícitas, separadas por vírgula. "*" é rejeitado.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Clerk/JWT. Em produção use obrigatoriamente uma instância de produção
# (chaves pk_live_ / sk_live_), nunca chaves de desenvolvimento pk_test_.
# O issuer e o JWKS são derivados da publishable key por padrão.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Opcionais para instalações com issuer/JWKS customizados.
CLERK_ISSUER=
CLERK_JWKS_URL=
# Configure somente se os tokens Clerk da instalação contiverem aud.
CLERK_JWT_AUDIENCE=
# Lista explícita, separada por vírgulas, de curadores autorizados.
CURATOR_EMAILS=

# Banco remoto Turso. Transações stateful exigem libsql:// ou wss://.
# URLs http:// e https:// são rejeitadas no startup para evitar falsa atomicidade.
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=
# Desenvolvimento local inicializa o schema automaticamente. A imagem de
# produção define 0 e executa `python -m scripts.migrate_db` antes dos workers.
MEDQUEST_AUTO_MIGRATE=1

# Segredo compartilhado entre o proxy Next.js e o backend Flask.
FLASK_API_PROXY_SECRET=

# Token separado para o endpoint operacional /api/metrics/performance.
# Se ausente, o endpoint fica desabilitado fora de testes.
METRICS_API_TOKEN=

# Notificações PWA / Web Push (Opt-in)
# Chaves VAPID (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@medquest.local

# Segredo de autenticação para o cron interno de lembretes FSRS (/api/notifications/cron/dispatch)
NOTIFICATIONS_CRON_SECRET=

# Proteção SSRF por allowlist para endpoints de Web Push.
# Em produção, deve conter os domínios permitidos separados por vírgula (aceita *. para subdomínios).
# Exemplos suportados: FCM (Google), Mozilla Push Service e Apple Web Push.
# Exemplo padrão recomendado:
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,*.push.services.mozilla.com,push.services.mozilla.com,*.push.apple.com,web.push.apple.com,push.apple.com
